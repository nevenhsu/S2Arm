#version 450
layout(local_size_x=1) in;
#ifdef RGBA2D
layout(set=0,binding=0) uniform sampler2D source;
#else
layout(set=0,binding=0) uniform sampler3D source;
#endif
layout(set=0,binding=1,std430) writeonly buffer Result { vec4 value[]; } result;
void main() {
    int i = int(gl_GlobalInvocationID.x);
#ifdef RGBA2D
    ivec2 p = ivec2(i,0);
#else
    ivec3 p = ivec3(0,0,i);
#endif
    result.value[i] = texelFetch(source,p,0);
}
